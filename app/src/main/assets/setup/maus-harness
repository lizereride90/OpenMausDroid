#!/bin/bash
# Foreground supervisor for the OpenMausBot harness. The app starts this
# through proot and keeps the process alive; restart it from the app if it dies.
set -u

export HOME=/root
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export ELECTRON_SKIP_BINARY_DOWNLOAD=1
# GUI apps opened by bots appear in desktop session 1 (if it is running).
export DISPLAY=:1
export TERM="${TERM:-xterm-256color}"

OMB_DATA_DIR="${OMB_DATA_DIR:-/root/.openmausbot}"
OMB_PORT="${OMB_PORT:-8799}"
mkdir -p "$OMB_DATA_DIR"
cd /root

exec openmausbot serve --port "$OMB_PORT" --data-dir "$OMB_DATA_DIR" --no-pair
